{
  "name": "vesta",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted PaaS",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vesta/db run migration:generate",
    "db:migrate": "pnpm --filter @vesta/db run migration:run",
    "db:revert": "pnpm --filter @vesta/db run migration:revert",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
