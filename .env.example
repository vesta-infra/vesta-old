# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgres://vesta:vesta@localhost:5432/vesta

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── API ─────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Secrets Encryption ─────────────────────────────────
ENCRYPTION_MASTER_KEY=change-me-in-production

# ─── Agent gRPC ──────────────────────────────────────────
GRPC_PORT=50051
GRPC_CA_CERT_PATH=./certs/ca.pem
GRPC_SERVER_CERT_PATH=./certs/server.pem
GRPC_SERVER_KEY_PATH=./certs/server-key.pem
