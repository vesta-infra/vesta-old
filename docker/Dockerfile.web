# ─── Vesta Web (Next.js) — production image (standalone output) ────────────────
# Requires `output: 'standalone'` in apps/web/next.config.ts (already set).
# Build from repository root:
#   docker build -f docker/Dockerfile.web -t vesta-web \
#     --build-arg NEXT_PUBLIC_API_URL=https://your-domain.com .

# ─── Stage 1: builder — install deps and `next build` ─────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Include every workspace package.json so pnpm can resolve the monorepo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/

COPY apps/web ./apps/web

# Next.js serves files from `public/`; create the directory if the repo omits it
RUN mkdir -p apps/web/public

# Baked into the client bundle; set at build time for the correct API origin
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@vesta/web...

# ─── Stage 2: runner — Next.js standalone server + static assets ─────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Monorepo layout: standalone bundle lives under apps/web inside the output root
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

WORKDIR /app/apps/web

EXPOSE 3000

CMD ["node", "server.js"]
