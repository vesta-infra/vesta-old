# ─── Vesta API (NestJS) — production image ─────────────────────────────────────
# Build from repository root:
#   docker build -f docker/Dockerfile.api -t vesta-api .

# ─── Stage 1: builder — install workspace deps and compile TypeScript ────────
FROM node:20-alpine AS builder

WORKDIR /app

# Enable the repo’s pinned pnpm version (see package.json "packageManager")
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Native addons (e.g. bcrypt) may compile on Alpine during install
RUN apk add --no-cache python3 make g++

# Workspace manifests (install before copying sources for better layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/config/package.json ./packages/config/

COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY packages/config ./packages/config

# Install and build dependency order: shared → db → api (^build in turbo)
RUN pnpm install --frozen-lockfile
RUN pnpm turbo run build --filter=@vesta/api...

# Drop devDependencies to shrink the copied node_modules in the runner stage
ENV CI=true
RUN pnpm prune --prod

# ─── Stage 2: runner — minimal runtime with built artifacts only ─────────────
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Reuse the pruned install plus compiled dist for the API and its workspace libs
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages/db/dist ./packages/db/dist
COPY --from=builder /app/packages/db/package.json ./packages/db/package.json
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

WORKDIR /app/apps/api

EXPOSE 3001

CMD ["node", "dist/main.js"]
